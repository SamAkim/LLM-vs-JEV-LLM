# ---- Jev via BeatAPI (Decisions API) ----
# Get a key at https://beatapi.io/dashboard
# Uses the free model jev-1.13-free by default ($0 input/output)
BEATAPI_API_KEY=""

# ---- LLM (Google Gemini via OpenAI-compatible endpoint) ----
# Get your API key at https://aistudio.google.com/apikey
# You can use a single GEMINI_API_KEY, or use two separate keys (GEMINI_API_KEY_1 & GEMINI_API_KEY_2)
# to eliminate concurrent rate-limit queuing between Pipeline A and Pipeline B.
#GEMINI_API_KEY=
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite

# ---- Illustrative cost rates (USD per 1M tokens), override with your real numbers ----
# Gemini 2.5 Flash: ~$0.15/MTok input, ~$0.60/MTok output → blended ~$0.30
GEMINI_RATE_PER_MTOK=0.30
# Jev free model: $0 input, $0 output → $0 total
# Jev paid (jev-1.13): $0.042/MTok input, free output
JEV_RATE_PER_MTOK=0.0
